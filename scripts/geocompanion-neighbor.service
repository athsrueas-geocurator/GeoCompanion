[Unit]
Description=Budgeted Reticulum neighbor transport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/geocompanion-neighbor/neighbor-budget.py
Restart=no
KillMode=control-group
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/geocompanion-neighbor
MemoryMax=180M
CPUQuota=10%
TasksMax=32

